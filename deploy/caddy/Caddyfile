{
	on_demand_tls {
		ask http://localhost:9123/
	}
}

# dijker.eu is the only host that may be indexed. Previews, and the temporary
# domain the site runs on until the switch, must stay out of search results.
(noindex_unless_canonical) {
	@not_canonical not host dijker.eu
	header @not_canonical X-Robots-Tag "noindex, nofollow"
}

# URLs of the old Strato site, mapped to their matching section so their
# ranking carries over. Dutch slugs are from the pre-2024 Dutch version, English
# ones from the current site. dijker.eu used to forward to dijkersite.eu with
# the path intact, so both domains can receive these.
(legacy_paths) {
	map {path} {legacy_path} {
		~^/the-dijker(/.*)?$ /en/#dijker
		~^/the-technique(/.*)?$ /en/#technique
		~^/the-creator(/.*)?$ /en/#creator
		~^/investing(/.*)?$ /en/#investing
		~^/contact(/.*)?$ /en/#contact
		~^/de-dijker(/.*)?$ /nl/#dijker
		~^/de-techniek(/.*)?$ /nl/#technique
		~^/de-bedenker(/.*)?$ /nl/#creator
		~^/investeren(/.*)?$ /nl/#investing
		~/Ligfiets2020_3_Dijker\.pdf$ /media/Ligfiets-2020.pdf
		~/Eusupino2020_Dijker\.pdf$ /media/EHPVA-magazine-2020.pdf
		~/\.relaxen\.mp4/video\.mp4$ /media/relaxen.mp4
		"~/\.dijker aandrijving\.mp4/video\.mp4$" /media/dijker_aandrijving.mp4
		default ""
	}
	@legacy expression {legacy_path} != ""
}

{$BASE_DOMAIN} {
	import legacy_paths
	redir @legacy {legacy_path} permanent

	import noindex_unless_canonical
	encode
	reverse_proxy production:3000
}

www.{$BASE_DOMAIN} {
	redir https://{$BASE_DOMAIN}{uri} permanent
}

# Unknown paths of the old site fall back to the English home page.
dijkersite.eu, www.dijkersite.eu {
	import legacy_paths
	redir @legacy https://{$BASE_DOMAIN}{legacy_path} permanent
	redir https://{$BASE_DOMAIN}/en/ permanent
}

*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}

	@preview header_regexp preview Host ^(pr-[0-9]+)[.]
	handle @preview {
		import noindex_unless_canonical
		encode
		reverse_proxy {re.preview.1}:3000
	}

	respond 404
}

# Only issue a preview certificate when that preview's container is actually
# running, so random subdomains can't burn the Let's Encrypt rate limit that is
# shared with every other *.rutgerpronk.com site. favicon.ico is used because
# it is a plain 200 that the locale middleware doesn't redirect.
http://localhost:9123 {
	@preview vars_regexp preview {query.domain} ^(pr-[0-9]+)[.]
	handle @preview {
		rewrite * /favicon.ico
		reverse_proxy {re.preview.1}:3000
	}

	respond 403
}
