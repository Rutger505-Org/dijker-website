# Production environment for the Docker Compose VM setup.
# Copy to `.env` and fill in the values:  cp .env.production.example .env

# Public domain served by Caddy (must have a DNS A record -> this VM).
APP_DOMAIN=dijker.rutgerpronk.com

# Optional: override the image. Defaults to a locally built image.
# Set to the Docker Hub image to pull instead of building, e.g.
#   APP_IMAGE=yourdockerhubuser/dijker-website:latest
# APP_IMAGE=dijker-website:latest

# --- Application config (mirrors the Kubernetes ConfigMap/Secret) ---

DISCORD_WEBHOOK_URL=
DATABASE_SQLITE_PATH=./data/db.sqlite

# generate with 'bunx auth secret --raw'
AUTH_SECRET=

# Email configuration for magic links
AUTH_EMAIL_FROM="The Dijker"
AUTH_EMAIL_HOST="smtp.gmail.com"
AUTH_EMAIL_PORT=465
AUTH_EMAIL_USER="rutger.pronk11@gmail.com"
AUTH_EMAIL_PASSWORD=""

# Trust the reverse proxy's X-Forwarded-* headers (Caddy sets them).
AUTH_TRUST_HOST=true
